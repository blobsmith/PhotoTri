<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Décodage des photos (JPEG, HEIC…) par les composants d'imagerie de Windows -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retirés des « using » implicites par UseWPF -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modèles de visages d'OpenCV Zoo : YuNet (MIT) pour la détection, SFace (Apache 2.0) pour la reconnaissance -->
    <None Include="Models\*.onnx" CopyToOutputDirectory="PreserveNewest" LinkBase="Models" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base GeoNames des villes (CC BY 4.0), construite par tools/geonames/build.mjs -->
    <EmbeddedResource Include="Data\cities.tsv.gz" LogicalName="PhotoTri.Core.Data.cities.tsv.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediaDevices" Version="2.0.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

</Project>
