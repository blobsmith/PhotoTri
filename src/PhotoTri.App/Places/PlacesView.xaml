<UserControl x:Class="PhotoTri.App.Places.PlacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:photos="clr-namespace:PhotoTri.App.Photos"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Liste des lieux et options -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <CheckBox x:Name="OnlineAddresses" Click="OnlineAddresses_Click">
                    <TextBlock TextWrapping="Wrap" Text="Rechercher les adresses précises en ligne (OpenStreetMap)" />
                </CheckBox>
                <TextBlock Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="20,2,0,0"
                           Text="Envoie les positions GPS de vos photos à OpenStreetMap, une par seconde." />
                <TextBlock x:Name="StatusText" Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Foreground="#999" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Villes : GeoNames (CC BY 4.0). Carte et adresses : © les contributeurs d'OpenStreetMap." />
            </StackPanel>
            <TreeView x:Name="PlaceTree" BorderThickness="0,0,1,0" SelectedItemChanged="PlaceTree_SelectedItemChanged" />
        </DockPanel>

        <!-- Carte et photos du lieu choisi -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,6" />
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="Map" />
                    <TextBlock x:Name="MapError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#777" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                </Grid>
            </Border>
            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />
            <photos:TimelineView x:Name="Timeline" Grid.Row="3"
                                 EmptyMessage="Aucune photo géolocalisée pour l'instant. Les photos de l'appareil photo contiennent en général leur position GPS." />
        </Grid>
    </Grid>
</UserControl>
