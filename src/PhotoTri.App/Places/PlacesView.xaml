<UserControl x:Class="PhotoTri.App.Places.PlacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:photos="clr-namespace:PhotoTri.App.Photos"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Lieux" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des lieux et options -->
            <DockPanel Grid.Column="0" Margin="0,0,20,0">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="OnlineAddresses" Click="OnlineAddresses_Click" Content="Adresses précises en ligne" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Envoie les positions GPS de vos photos à OpenStreetMap, une par seconde." />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="Villes : GeoNames (CC BY 4.0). Carte et adresses : © les contributeurs d'OpenStreetMap." />
                    </StackPanel>
                </Border>
                <TreeView x:Name="PlaceTree" Background="Transparent" BorderThickness="0" SelectedItemChanged="PlaceTree_SelectedItemChanged" />
            </DockPanel>

            <!-- Carte et photos du lieu choisi -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="1">
                    <Grid>
                        <wv2:WebView2 x:Name="Map" />
                        <TextBlock x:Name="MapError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                    </Grid>
                </Border>
                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />
                <photos:MediaBrowser x:Name="Timeline" Grid.Row="3"
                                     EmptyMessage="Aucune photo géolocalisée pour l'instant. Les photos de l'appareil photo contiennent en général leur position GPS." />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
