<UserControl x:Class="PhotoTri.App.Photos.MediaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel>
        <!-- Actions sur la sélection -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="SelectAllButton" Content="Tout sélectionner" Icon="{ui:SymbolIcon SelectAllOn24}" Appearance="Transparent"
                               Click="SelectAll_Click" Margin="0,0,4,0" ToolTip="Ctrl+A" />
                    <ui:Button x:Name="CopyButton" Content="Copier" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" Margin="0,0,4,0"
                               ToolTip="Copier les fichiers choisis, pour les coller dans un dossier, un e-mail… (Ctrl+C)" />
                    <ui:Button x:Name="ShareButton" Content="Partager" Icon="{ui:SymbolIcon Share24}" Click="Share_Click" Margin="0,0,4,0"
                               ToolTip="Partager les fichiers choisis avec une application, un contact ou un appareil à proximité" />
                    <ui:Button x:Name="DeleteButton" Content="Supprimer" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="Delete_Click"
                               ToolTip="Mettre les fichiers choisis à la corbeille de Windows (Suppr)" />
                </StackPanel>
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>

        <ListView x:Name="List" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                  GridViewColumnHeader.Click="Header_Click" SizeChanged="List_SizeChanged">
            <ListView.View>
                <GridView x:Name="Columns">
                    <GridViewColumn Width="58">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="44" Height="44" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Border CornerRadius="4">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14" Foreground="White"
                                                       Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Nom" Width="190" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Date" Width="122" DisplayMemberBinding="{Binding DateText}" />
                    <GridViewColumn Header="Lieu" Width="170" DisplayMemberBinding="{Binding PlaceText}" />
                    <GridViewColumn Header="Personnes" Width="130" DisplayMemberBinding="{Binding PeopleText}" />
                    <GridViewColumn Header="Type" Width="160" DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn Header="Taille" Width="72" DisplayMemberBinding="{Binding SizeText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
