<Window x:Class="PhotoTri.App.Photos.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PhotoTri" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="Black" Foreground="White" Width="1000" Height="700" ShowInTaskbar="False"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove">
    <Window.Resources>
        <!-- Boutons blancs sur fond noir, quel que soit le thème de Windows -->
        <Style x:Key="ChromeButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MouseOverBackground" Value="#33FFFFFF" />
            <Setter Property="PressedBackground" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NavButton" TargetType="ui:Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Média -->
        <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                      MediaOpened="Video_MediaOpened" MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed" />
        <TextBlock x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="520" Foreground="#CCC" FontSize="15" />

        <!-- Barre du haut, en surimpression ; elle se cache quand la souris ne bouge plus -->
        <Border x:Name="TopBar" VerticalAlignment="Top" Background="#B0000000" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="CopyButton" Content="Copier" Icon="{ui:SymbolIcon Copy24}" Style="{StaticResource ChromeButton}"
                               Click="Copy_Click" ToolTip="Copier dans le presse-papiers, pour le coller dans un dossier, un e-mail, un document… (Ctrl+C)" />
                    <ui:Button Content="Partager" Icon="{ui:SymbolIcon Share24}" Style="{StaticResource ChromeButton}"
                               Click="Share_Click" ToolTip="Partager avec une application, un contact ou un appareil à proximité" />
                    <ui:Button Icon="{ui:SymbolIcon Open24}" Style="{StaticResource ChromeButton}"
                               Click="OpenDefault_Click" ToolTip="Ouvrir avec l'application par défaut" />
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource ChromeButton}"
                               Click="ShowInExplorer_Click" ToolTip="Afficher dans l'Explorateur" />
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Style="{StaticResource ChromeButton}" Margin="12,0,0,0"
                               Click="Close_Click" ToolTip="Fermer (Échap)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="DetailText" Foreground="#BBB" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Flèches de navigation -->
        <ui:Button x:Name="PreviousButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                   Icon="{ui:SymbolIcon ChevronLeft24}" Style="{StaticResource NavButton}" Click="Previous_Click" ToolTip="Précédente (←)" />
        <ui:Button x:Name="NextButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                   Icon="{ui:SymbolIcon ChevronRight24}" Style="{StaticResource NavButton}" Click="Next_Click" ToolTip="Suivante (→)" />

        <!-- Contrôles de la vidéo, en surimpression en bas -->
        <Border x:Name="VideoControls" VerticalAlignment="Bottom" Background="#B0000000" Padding="20,12" Visibility="Collapsed">
            <DockPanel>
                <ui:Button x:Name="PlayPauseButton" DockPanel.Dock="Left" Content="Pause" Icon="{ui:SymbolIcon Pause24}" Style="{StaticResource ChromeButton}"
                           Click="PlayPause_Click" Margin="0,0,12,0" MinWidth="110" />
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#CCC" />
                <Slider x:Name="Position" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        Thumb.DragStarted="Position_DragStarted" Thumb.DragCompleted="Position_DragCompleted"
                        PreviewMouseLeftButtonUp="Position_MouseUp" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
