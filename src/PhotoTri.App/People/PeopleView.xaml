<UserControl x:Class="PhotoTri.App.People.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:people="clr-namespace:PhotoTri.App.People"
             xmlns:photos="clr-namespace:PhotoTri.App.Photos">
    <UserControl.Resources>
        <!-- Liste de gauche -->
        <DataTemplate DataType="{x:Type people:HeaderItem}">
            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Foreground="#666" Margin="2,12,0,4" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type people:PersonItem}">
            <DockPanel Margin="2">
                <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Margin="0,0,10,0" Background="#DDD">
                    <Border.Clip>
                        <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                    </Border.Clip>
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Count}" Foreground="#777" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type people:GroupItem}">
            <DockPanel Margin="2">
                <Border Width="44" Height="44" Margin="0,0,10,0" Background="#DDD">
                    <Border.Clip>
                        <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                    </Border.Clip>
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Qui est-ce ?" FontStyle="Italic" />
                    <TextBlock Text="{Binding Count}" Foreground="#777" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Vignettes de visages (panneaux de droite) -->
        <DataTemplate x:Key="FaceTemplate" DataType="{x:Type people:FaceTile}">
            <Grid Width="96" Height="96" Margin="3" ToolTip="{Binding ToolTip}">
                <Border Background="#DDD" CornerRadius="4" ClipToBounds="True">
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                </Border>
                <Button x:Name="RemoveButton" Content="✕" Width="24" Height="24" Padding="0" FontSize="11"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Cursor="Hand"
                        Background="#CC000000" Foreground="White" BorderThickness="0"
                        Click="RemoveFace_Click" Tag="{Binding}" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Foreground="#555" TextWrapping="Wrap" />
                <TextBlock Foreground="#999" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Les visages sont analysés sur ce PC, rien n'est envoyé sur Internet." />
            </StackPanel>
            <ListBox x:Name="PeopleList" BorderThickness="0,0,1,0" HorizontalContentAlignment="Stretch"
                     SelectionChanged="PeopleList_SelectionChanged" />
        </DockPanel>

        <Grid Grid.Column="1">
            <!-- Rien à afficher -->
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />

            <!-- Groupe de visages à nommer -->
            <DockPanel x:Name="GroupPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Qui est-ce ?" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="GroupSubtitle" Foreground="#666" Margin="0,2,0,10" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,0,0,10">
                        <ComboBox x:Name="NameBox" IsEditable="True" Width="240" Margin="0,0,8,4"
                                  KeyDown="NameBox_KeyDown" ToolTip="Tapez un nom, ou choisissez une personne déjà nommée pour lui ajouter ces visages" />
                        <Button Content="Nommer" Padding="14,4" Margin="0,0,8,4" FontWeight="SemiBold" Click="NameGroup_Click" />
                        <Button Content="Ignorer ces visages" Padding="14,4" Margin="0,0,0,4" Click="IgnoreGroup_Click"
                                ToolTip="Inconnus, passants, affiches… : ce groupe ne sera plus proposé" />
                    </WrapPanel>
                    <TextBlock Foreground="#888" FontSize="11" Margin="0,0,0,6"
                               Text="Survolez un visage et cliquez sur ✕ pour le retirer du groupe s'il n'appartient pas à cette personne." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GroupFaces" ItemTemplate="{StaticResource FaceTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Personne nommée -->
            <DockPanel x:Name="PersonPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="RenameBox" Width="200" Margin="0,0,6,0" Visibility="Collapsed" KeyDown="RenameBox_KeyDown" />
                            <Button x:Name="RenameButton" Content="Renommer…" Padding="12,4" Click="Rename_Click"
                                    ToolTip="Donner le nom d'une autre personne fusionne les deux" />
                        </StackPanel>
                        <TextBlock x:Name="PersonTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Expander x:Name="FacesExpander" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Foreground="#888" FontSize="11" Margin="0,2,0,4" x:Name="FacesHint" />
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PersonFaces" ItemTemplate="{StaticResource FaceTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <photos:TimelineView x:Name="Timeline" EmptyMessage="Aucune photo." />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
