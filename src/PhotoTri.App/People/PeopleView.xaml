<UserControl x:Class="PhotoTri.App.People.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:people="clr-namespace:PhotoTri.App.People"
             xmlns:photos="clr-namespace:PhotoTri.App.Photos">
    <UserControl.Resources>
        <!-- Liste de gauche -->
        <DataTemplate DataType="{x:Type people:HeaderItem}">
            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="12" Margin="4,14,0,6"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type people:PersonItem}">
            <DockPanel Margin="2,3">
                <Grid Width="48" Height="48" Margin="0,0,12,0">
                    <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type people:GroupItem}">
            <DockPanel Margin="2,3">
                <Grid Width="48" Height="48" Margin="0,0,12,0">
                    <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Qui est-ce ?" FontStyle="Italic" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Visage en grand portrait rond, avec ✕ au survol -->
        <DataTemplate x:Key="FaceTemplate" DataType="{x:Type people:FaceTile}">
            <Grid Width="104" Height="104" Margin="4" ToolTip="{Binding ToolTip}">
                <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <ui:Button x:Name="RemoveButton" Width="30" Height="30" Padding="0" CornerRadius="15"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Cursor="Hand"
                           Icon="{ui:SymbolIcon Dismiss24}" Appearance="Danger"
                           Click="RemoveFace_Click" Tag="{Binding}" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Personnes" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Visages analysés sur ce PC uniquement." />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="PeopleList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource SubtleListItem}"
                         SelectionChanged="PeopleList_SelectionChanged" />
            </DockPanel>

            <Grid Grid.Column="1">
                <!-- Rien à afficher -->
                <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <ui:SymbolIcon Symbol="People24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Groupe de visages à nommer -->
                <DockPanel x:Name="GroupPanel" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Qui est-ce ?" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="GroupSubtitle" Style="{StaticResource Hint}" Margin="0,2,0,12" />
                            <WrapPanel>
                                <ComboBox x:Name="NameBox" IsEditable="True" Width="260" Margin="0,0,8,4"
                                          KeyDown="NameBox_KeyDown" ToolTip="Tapez un nom, ou choisissez une personne déjà nommée pour lui ajouter ces visages" />
                                <ui:Button Content="Nommer" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Margin="0,0,8,4" Click="NameGroup_Click" />
                                <ui:Button Content="Ignorer ces visages" Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,4" Click="IgnoreGroup_Click"
                                           ToolTip="Inconnus, passants, affiches… : ce groupe ne sera plus proposé" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="Survolez un visage et cliquez sur ✕ pour le retirer du groupe s'il n'appartient pas à cette personne." />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GroupFaces" ItemTemplate="{StaticResource FaceTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Personne nommée -->
                <DockPanel x:Name="PersonPanel" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBox x:Name="RenameBox" Width="220" Margin="0,0,8,0" Visibility="Collapsed" KeyDown="RenameBox_KeyDown" />
                                <ui:Button x:Name="RenameButton" Content="Renommer…" Icon="{ui:SymbolIcon Edit24}" Click="Rename_Click"
                                           ToolTip="Donner le nom d'une autre personne fusionne les deux" />
                            </StackPanel>
                            <Grid Width="64" Height="64" Margin="0,0,16,0">
                                <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="PersonPortrait" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PersonTitle" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="PersonSubtitle" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Expander x:Name="FacesExpander" Margin="0,4,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6" x:Name="FacesHint" />
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PersonFaces" ItemTemplate="{StaticResource FaceTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <photos:TimelineView x:Name="Timeline" EmptyMessage="Aucune photo." />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
