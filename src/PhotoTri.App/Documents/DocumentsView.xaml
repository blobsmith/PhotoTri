<UserControl x:Class="PhotoTri.App.Documents.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:documents="clr-namespace:PhotoTri.App.Documents"
             xmlns:photos="clr-namespace:PhotoTri.App.Photos">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type documents:CategoryItem}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Documents" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="Pour corriger un classement, passez en liste, choisissez les photos puis « Ce n'est pas un document » ou « Classer comme… »." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Texte lu sur ce PC uniquement." />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource SubtleListItem}" SelectionChanged="Categories_SelectionChanged" />
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <photos:MediaBrowser x:Name="Browser"
                                     EmptyMessage="Aucun document reconnu pour l'instant. Les photos sont lues en arrière-plan : pièces d'identité, permis, factures et feuilles apparaîtront ici." />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
